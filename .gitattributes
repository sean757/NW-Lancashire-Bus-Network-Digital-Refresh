# Enforce LF line endings for all shell scripts so they work inside Linux containers
# regardless of the OS the developer checks out on.
*.sh        text eol=lf
Dockerfile  text eol=lf
*.py        text eol=lf
*.sql       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.js        text eol=lf
