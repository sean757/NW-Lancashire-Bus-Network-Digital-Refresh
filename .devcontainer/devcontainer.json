{
  "name": "scc200-transport",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",
  "workspaceMount": "source=${localWorkspaceFolder}/,target=/workspace,type=bind,consistency=cached",
  "workspaceFolder": "/workspace",
  "updateRemoteUserUID": false,
  "remoteUser": "root",
  "runArgs": [
    "--network=host"
  ],
  "postCreateCommand": "apt-get update && apt-get install -y postgresql-client && pip install fastapi uvicorn[standard] asyncpg sqlalchemy[asyncio] pydantic-settings stomp.py httpx python-dotenv lxml psycopg2-binary requests && npm install --prefix front-end",
  "postStartCommand": "npm start --prefix front-end",
  "forwardPorts": [
    8000
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.isort",
        "ms-python.autopep8",
        "eamodio.gitlens",
        "mhutchie.git-graph",
        "gruntfuggly.todo-tree",
        "mohsen1.prettify-json"
      ],
      "settings": {
        "files.eol": "\n",
        "files.autoSave": "onFocusChange",
        "editor.formatOnSave": true
      }
    }
  }
}
